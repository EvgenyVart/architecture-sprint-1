        <mxCell id="oBqSWiT8dcZNpgR47qOW-25" value="ETL процессы" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="oBqSWiT8dcZNpgR47qOW-22">
